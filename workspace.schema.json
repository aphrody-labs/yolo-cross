{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rust-cross development workspace",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositories"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "kind", "targetCatalog"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["cargo", "bun-package", "container-images"] },
          "targetCatalog": { "type": "boolean" }
        }
      }
    }
  }
}
